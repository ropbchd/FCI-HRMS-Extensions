{
  "manifest_version": 3,
  "name": "FCI Audit Leave Assistant",
  "version": "1.1",
  "description": "Assists with Audit Leave request processing on FCI HRMS portal",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://www.hrmsfci.in/*",
    "https://hrmsfci.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hrmsfci.in/lta/leave-audit/list",
        "https://hrmsfci.in/lta/leave-audit/list"
      ],
      "js": ["content_list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hrmsfci.in/workflow/review/*",
        "https://hrmsfci.in/workflow/review/*"
      ],
      "js": ["content_audit_leave.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hrmsfci.in/workflow/add-reviewer/*",
        "https://hrmsfci.in/workflow/add-reviewer/*"
      ],
      "js": ["content_add_reviewer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}