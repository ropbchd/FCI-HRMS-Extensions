{
  "manifest_version": 3,
  "name": "FCI NOC Assistant",
  "version": "1.0",
  "description": "Automates NOC request processing on FCI HRMS portal",
  "permissions": [
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.hrmsfci.in/*",
    "https://hrmsfci.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hrmsfci.in/er/noc/other-examination",
        "https://hrmsfci.in/er/noc/other-examination"
      ],
      "js": [
        "content_noc_list.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hrmsfci.in/workflow/review/*",
        "https://hrmsfci.in/workflow/review/*"
      ],
      "js": [
        "content.js",
        "learning/storage.js",
        "learning/page-type-scorer.js",
        "learning/patterns.js"
      ],
      "run_at": "document_idle",
      "css": [
        "floating_window.css"
      ]
    },
    {
      "matches": [
        "https://www.hrmsfci.in/workflow/add-reviewer/*",
        "https://hrmsfci.in/workflow/add-reviewer/*"
      ],
      "js": [
        "content_add_reviewer.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "css": [
        "floating_window.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "floating-window-framework/**/*",
        "learning/**/*"
      ],
      "matches": [
        "https://www.hrmsfci.in/*",
        "https://hrmsfci.in/*"
      ]
    }
  ]
}