{
  "manifest_version": 3,
  "name": "FCI Employee Profile Update Assistant",
  "version": "1.0",
  "description": "Assists with Employee Profile Update request processing on FCI HRMS portal",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://www.hrmsfci.in/*",
    "https://hrmsfci.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hrmsfci.in/corehr/transaction/profile-request",
        "https://hrmsfci.in/corehr/transaction/profile-request"
      ],
      "js": ["content_list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hrmsfci.in/corehr/transaction/profile-request/approve/*",
        "https://hrmsfci.in/corehr/transaction/profile-request/approve/*"
      ],
      "js": ["content_approve.js"],
      "run_at": "document_idle"
    }
  ]
}
