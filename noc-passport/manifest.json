{
  "manifest_version": 3,
  "name": "FCI NOC Passport Assistant",
  "version": "2.0",
  "description": "Automates NOC Passport request processing on FCI HRMS portal",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.hrmsfci.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.hrmsfci.in/er/noc/passport"],
      "js": ["content_passport_list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hrmsfci.in/workflow/review/*"],
      "js": ["floating_window.js", "content.js"],
      "css": ["floating_window.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hrmsfci.in/workflow/add-reviewer/*"],
      "js": ["floating_window.js", "content_add_reviewer.js"],
      "css": ["floating_window.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
