// Leave Encashment - Google Sheets Write-Back Script (Simplified)
// Deploy as Web App to accept POST requests from Chrome Extension

function doPost(e) {
  try {
    const payload = JSON.parse(e.parameter.payload);
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getActiveSheet();
    
    const lastRow = sheet.getLastRow();
    const newRow = lastRow + 1;
    
    // Columns: B, D, E, F, G, H
    // B: From HRMS, D: EL Available, E: Encashable, 
    // F: Leave Requested, G: Review, H: Final Remark
    
    sheet.getRange(newRow, 2).setValue(payload.fromHRMS || '');
    sheet.getRange(newRow, 4).setValue(payload.elAvailable || '');
    sheet.getRange(newRow, 5).setValue(payload.encashable || '');
    sheet.getRange(newRow, 6).setValue(payload.leaveRequested || '');
    sheet.getRange(newRow, 7).setValue(payload.review || '');
    sheet.getRange(newRow, 8).setValue(payload.finalRemark || '');
    
    return ContentService
      .createTextOutput(JSON.stringify({ success: true, message: 'Entry added successfully' }))
      .setMimeType(ContentService.MimeType.JSON);
    
  } catch (error) {
    return ContentService
      .createTextOutput(JSON.stringify({ success: false, message: error.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

