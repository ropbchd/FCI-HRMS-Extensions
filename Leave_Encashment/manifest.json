{
  "manifest_version": 3,
  "name": "FCI Leave Encashment Assistant",
  "version": "1.0",
  "description": "Automates Leave Encashment request processing on FCI HRMS portal",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.hrmsfci.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.hrmsfci.in/lta/leave-encashment/approval-landing"],
      "js": ["content_leave_list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hrmsfci.in/lta/leave-encashment/view/*",
        "https://www.hrmsfci.in/lta/leave-encashment/details/*",
        "https://www.hrmsfci.in/lta/leave-encashment/*"
      ],
      "js": ["content_detail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hrmsfci.in/workflow/review/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hrmsfci.in/workflow/add-reviewer/*"],
      "js": ["content_add_reviewer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
